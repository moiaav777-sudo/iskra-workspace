# Скопировать в .env (в репозиторий не попадает, см. .gitignore).

# Порт выдан общим треком (см. ../CLAUDE.md → «Продуктив» → п. 7).
TRANSCRIBER_PORT=8980

# Общий секрет с порталом: тот же, что в portal/.env.
PORTAL_SECRET=

# Ключ «Искры» в репозитории не хранится. Сервис читает ISKRA_API_KEY из этого же .env при
# каждом вызове — на сервере его записывает портал при выкладке (как у остальных сервисов).
# Без ключа сервис работает, но разбор записи честно отвечает «Ключ «Искры» не настроен».
# ISKRA_API_KEY=
# ISKRA_URL=https://cloud.iskrabot.ru

# Журнал портала — значение по умолчанию менять не нужно.
# AUDIT_URL=http://127.0.0.1:8700/internal/audit

# База и временные загрузки — вне репозитория, по умолчанию рядом с сервисом.
# TRANSCRIBER_DB=data/transcriber.db
# TRANSCRIBER_UPLOADS=data/uploads

# Предел на файл (байты; выше 500 МБ не поднимается — это предел «Искры») и на длительность (секунды).
# TRANSCRIBER_MAX_BYTES=524288000
# TRANSCRIBER_MAX_SECONDS=14400

# Движок распознавания речи. Решение пользователя 02.10: распознаёт «Искра» (по умолчанию).
#   iskra   — файл записи уходит в чат «Искры», она возвращает дословную расшифровку;
#   fake    — подмена для тестов и показа интерфейса (пометка «демонстрационный режим»);
#   whisper — локальная faster-whisper, опциональный резерв (requirements-whisper.txt).
TRANSCRIBER_ENGINE=iskra

# Сроки «Искры» (секунды; правила API «Искры» — ../CLAUDE.md, п. 5в): загрузка файла; сколько ждём
# один фоновый прогон (у «Искры» он до 15 минут), прежде чем попросить готовую расшифровку повторным
# прогоном; общий срок ожидания после загрузки (два прогона и запас); скачивание TXT-файла
# расшифровки и его предел в байтах; запасной путь — сколько частей («дальше») просить самое большее.
# TRANSCRIBER_ISKRA_UPLOAD_TIMEOUT=900
# TRANSCRIBER_ISKRA_RUN_LIMIT=960
# TRANSCRIBER_ISKRA_DEADLINE=2400
# TRANSCRIBER_ISKRA_DOWNLOAD_TIMEOUT=300
# TRANSCRIBER_ISKRA_RESULT_MAX_BYTES=52428800
# TRANSCRIBER_ISKRA_MAX_PARTS=40

# Размер модели faster-whisper — только для резервного движка whisper.
# TRANSCRIBER_WHISPER_MODEL=small

# Стенд без портала: вход подставляется (dev/admin), секрет не проверяется.
# Допустимо только когда PORTAL_SECRET пуст.
# TRANSCRIBER_DEV=1
