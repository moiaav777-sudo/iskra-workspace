# Скопировать в <PROFILES_HOME>/.env (в репозиторий не попадает, см. .gitignore).

# Порт выдан общим треком (решение пользователя 05.10). На стенде — 8991.
PROFILES_PORT=8990

# Общий секрет с порталом: тот же, что в portal/.env. Без него заголовкам X-Portal-* не верим.
PORTAL_SECRET=

# Ключ «Искры» в репозитории не хранится. Сервис читает ISKRA_API_KEY из этого же .env при каждом
# вызове — на сервере его записывает портал (KEY_TARGETS: «Объективки», PROFILES_HOME, .env).
# Без ключа реестр, карточки, Word и объединение работают; сбор «Искрой» честно отвечает 503.
# ISKRA_API_KEY=
# ISKRA_URL=https://cloud.iskrabot.ru

# Портал (журнал /internal/audit, сверка ФИО /internal/people/check) — по умолчанию менять не нужно.
# PORTAL_URL=http://127.0.0.1:8700

# Данные: по умолчанию <PROFILES_HOME>/data (база profiles.db, photos/, docx/, merged/).
# PROFILES_DATA=

# Стенд без портала: вход подставляется (dev, сотрудник). Только когда PORTAL_SECRET пуст.
# PROFILES_DEV=1
