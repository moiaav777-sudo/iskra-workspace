# Настройки запуска рабочего пространства (./run.sh и docker compose). Скопируйте в .env и заполните.

# Ключ API «Искры» (cloud.iskrabot.ru → ключи API; права: chat:run, skills:run, web_search, files:write, files:read).
# Пусто — пространство работает без ИИ; ключ можно ввести позже в «Администрирование → Искра».
ISKRA_API_KEY=
ISKRA_URL=https://cloud.iskrabot.ru

# Порт и адрес шлюза. В контейнере HOST=0.0.0.0.
PORT=8080
HOST=127.0.0.1
# Внешний адрес, который попадает в письма сотрудникам (временные пароли).
PUBLIC_URL=http://localhost:8080

# Учётные записи стенда. Администратор — люди, доступы, ключ «Искры», журнал (документы он не правит);
# сотрудник — работа во всех сервисах. Пароли каждый запуск приводятся к этим строкам: поменяли здесь —
# перезапустили. Для боевого экземпляра поставьте свои и уберите сотрудника (пустой USER_LOGIN).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
USER_LOGIN=user
USER_PASSWORD=user

# Секреты. Пустые — run.sh сгенерирует и впишет сюда; менять потом не нужно.
PORTAL_SECRET=
SECRET_KEY=
