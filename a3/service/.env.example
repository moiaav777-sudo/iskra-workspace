# Скопировать в service/.env. Настоящий .env в репозиторий не попадает.

# Порт выдаёт общий трек (см. ../TRACK.md). До выдачи — 8940.
A3_PORT=8940

# Общий секрет с порталом: тот же, что в portal/.env.
PORTAL_SECRET=

# Ключ «Искры» здесь НЕ хранится (см. ../CLAUDE.md → «Нельзя»).
# Сервис читает его из ~/.work-portal-dev/a3.env (строка ISKRA_API_KEY=),
# на сервере туда же его должен записывать портал. Путь можно задать
# переменной A3_SECRETS.

# Журнал портала и конструктор листа — значения по умолчанию менять не нужно.
# AUDIT_URL=http://127.0.0.1:8700/internal/audit
# A3_KIT=../a3-kit.html
# A3_DB=data/a3.db
